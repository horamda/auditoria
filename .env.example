# Copiar a .env y completar. NUNCA commitear .env.
QA_ENV=development
QA_SECRET_KEY=            # obligatorio: python -c "import secrets;print(secrets.token_urlsafe(48))"
# MySQL exclusiva de QA Control Center (no usar bases de las aplicaciones bajo prueba)
QA_DATABASE_URL=mysql+pymysql://qacc:CAMBIAR@127.0.0.1:3307/qa_control_center?charset=utf8mb4
MYSQL_ROOT_PASSWORD=CAMBIAR
MYSQL_PASSWORD=CAMBIAR
QA_CORS_ORIGINS=http://localhost:5173
# Rutas locales que el descubrimiento puede leer (separadas por ;). Lectura únicamente.
QA_ALLOWED_REPO_ROOTS=C:/Users/horac/Desktop/Proyectos WEB/control_asistencia
QA_WORKER_THREADS=4
QA_MAX_VIRTUAL_USERS=1000
QA_KILL_SWITCH=false
# Credenciales de cuentas de PRUEBA: <prefijo del entorno><NOMBRE>, referenciadas como ${NOMBRE} en los escenarios
# QA_FICHAYA_STG_USER=
# QA_FICHAYA_STG_PASSWORD=
